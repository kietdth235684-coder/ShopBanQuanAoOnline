@model List<PhieuDoiTra>
@{ ViewData["Title"] = "Đổi trả"; }
<div class="page-title"><h1>Phiếu đổi trả</h1><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Lập phiếu đổi trả</a></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Phiếu</th><th>Ngày</th><th>Hóa đơn</th><th>Lý do</th><th>Nhân viên</th><th class="text-end">Tiền hoàn</th><th></th></tr></thead><tbody>
@foreach (var p in Model)
{ <tr><td>DT@p.MaPdt</td><td>@p.NgayLap.ToString("dd/MM/yyyy HH:mm")</td><td><a asp-controller="Hoadons" asp-action="Details" asp-route-id="@p.MaHd">HD@p.MaHd</a></td><td>@p.LyDo</td><td>@p.MaNvNavigation?.Ten</td>
    <td class="text-end">@p.TienHoan.ToString("N0") đ</td><td><a asp-action="Details" asp-route-id="@p.MaPdt" class="btn btn-sm btn-outline-primary">Xem</a></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">Chưa có phiếu đổi trả.</td></tr> }
</tbody></table></div></div>
