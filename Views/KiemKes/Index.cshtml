@model List<PhieuKiemKe>
@{ ViewData["Title"] = "Kiểm kê"; }
<div class="page-title"><h1>Phiếu kiểm kê</h1><a asp-action="Create" class="btn btn-primary"><i class="bi bi-clipboard-plus"></i> Kiểm kê mới</a></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Số phiếu</th><th>Ngày</th><th>Người kiểm</th><th class="text-end">Số dòng</th><th class="text-end">Dòng lệch</th><th class="text-end">Tổng chênh lệch</th><th></th></tr></thead><tbody>
@foreach (var p in Model)
{ <tr><td>KK@p.MaKk</td><td>@p.NgayKiemKe.ToString("dd/MM/yyyy HH:mm")</td><td>@p.MaNvNavigation?.Ten</td><td class="text-end">@p.CtKiemKes.Count</td>
    <td class="text-end">@p.CtKiemKes.Count(c => c.ChenhLech != 0)</td><td class="text-end">@p.CtKiemKes.Sum(c => c.ChenhLech)</td>
    <td><a asp-action="Details" asp-route-id="@p.MaKk" class="btn btn-sm btn-outline-primary">Xem</a></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">Chưa có phiếu kiểm kê.</td></tr> }
</tbody></table></div></div>
