@{ ViewData["Title"] = "Lập phiếu xuất"; ViewData["CoDonGia"] = false; }
<div class="page-title"><h1>Lập phiếu xuất kho</h1><a asp-action="Index" class="btn btn-light">← Danh sách</a></div>
<div class="card"><div class="card-body">
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-md-5 mb-3"><label class="form-label">Lý do xuất</label>
            <input name="lyDo" list="dsLyDo" maxlength="100" class="form-control" required />
            <datalist id="dsLyDo">@foreach (var l in ShopBanQuanAoOnline.Controllers.PhieuXuatsController.LyDoMau) { <option value="@l"></option> }</datalist></div>
        <div class="col-md-7 mb-3"><label class="form-label">Ghi chú</label><input name="ghiChu" maxlength="255" class="form-control" /></div>
    </div>
    <partial name="_DongPhieuKho" />
    <button class="btn btn-primary"><i class="bi bi-save"></i> Lưu phiếu xuất</button>
</form>
</div></div>
