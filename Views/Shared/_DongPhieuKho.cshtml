@* Bảng nhập dòng hàng cho phiếu nhập / phiếu xuất. ViewData["CoDonGia"] = true để hiện cột đơn giá nhập. *@
@{
    var ds = (List<BienThe>)ViewBag.BienThes;
    bool coGia = (bool)(ViewData["CoDonGia"] ?? false);
}
<table class="table align-middle" id="bangDong">
    <thead><tr><th style="min-width:320px">Sản phẩm – size / màu</th><th style="width:140px">Số lượng</th>@if (coGia) { <th style="width:180px">Đơn giá nhập</th><th class="text-end">Thành tiền</th> }<th></th></tr></thead>
    <tbody>
        <tr class="dong">
            <td><select name="maBt" class="form-select chon-bt">
                <option value="0">-- Chọn sản phẩm --</option>
                @foreach (var b in ds)
                {
                    <option value="@b.MaBt" data-gia="@b.MaMhNavigation?.GiaNhap">@b.MaMhNavigation?.Ten – @b.TenBienThe (tồn @b.SoLuongTon)</option>
                }
            </select></td>
            <td><input type="number" name="soLuong" min="1" value="1" class="form-control sl" /></td>
            @if (coGia) { <td><input type="number" name="donGia" min="0" value="0" class="form-control gia" /></td><td class="text-end tt">0</td> }
            <td><button type="button" class="btn btn-sm btn-outline-danger xoa-dong"><i class="bi bi-x"></i></button></td>
        </tr>
    </tbody>
    @if (coGia) { <tfoot><tr><th colspan="3" class="text-end">Tổng tiền</th><th class="text-end" id="tongTien">0</th><th></th></tr></tfoot> }
</table>
<button type="button" class="btn btn-outline-success mb-3" id="themDong"><i class="bi bi-plus"></i> Thêm dòng</button>
<script>
(function () {
    var bang = document.querySelector('#bangDong tbody');
    var mau = bang.querySelector('.dong').cloneNode(true);
    function tinh() {
        var tong = 0;
        bang.querySelectorAll('.dong').forEach(function (r) {
            var g = r.querySelector('.gia'); if (!g) return;
            var t = (parseInt(r.querySelector('.sl').value) || 0) * (parseInt(g.value) || 0);
            r.querySelector('.tt').textContent = t.toLocaleString('vi-VN'); tong += t;
        });
        var el = document.getElementById('tongTien'); if (el) el.textContent = tong.toLocaleString('vi-VN');
    }
    document.getElementById('themDong').addEventListener('click', function () { bang.appendChild(mau.cloneNode(true)); });
    bang.addEventListener('click', function (e) {
        var nut = e.target.closest('.xoa-dong');
        if (nut && bang.querySelectorAll('.dong').length > 1) { nut.closest('tr').remove(); tinh(); }
    });
    bang.addEventListener('change', function (e) {
        if (e.target.classList.contains('chon-bt')) {
            var g = e.target.closest('tr').querySelector('.gia');
            var opt = e.target.selectedOptions[0];
            if (g && opt && opt.dataset.gia) g.value = opt.dataset.gia;
        }
        tinh();
    });
    bang.addEventListener('input', tinh);
})();
</script>
