@model List<NhaCungCap>
@{ ViewData["Title"] = "Nhà cung cấp"; }
<div class="page-title"><h1>Nhà cung cấp</h1><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm nhà cung cấp</a></div>
<div class="card mb-3"><div class="card-body"><form method="get" class="d-flex gap-2" style="max-width:420px">
    <input name="tukhoa" value="@ViewBag.tukhoa" class="form-control" placeholder="Tên hoặc số điện thoại" /><button class="btn btn-secondary">Tìm</button></form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Mã</th><th>Tên</th><th>Điện thoại</th><th>Email</th><th>Địa chỉ</th><th class="text-end">Số phiếu nhập</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var n in Model)
{
    <tr><td>@n.MaNcc</td><td><a asp-action="Details" asp-route-id="@n.MaNcc">@n.Ten</a></td><td>@n.DienThoai</td><td>@n.Email</td><td>@n.DiaChi</td>
        <td class="text-end">@n.PhieuNhaps.Count</td>
        <td>@if (n.TrangThai) { <span class="badge bg-success">Đang hợp tác</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
        <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@n.MaNcc" class="btn btn-sm btn-outline-secondary">Sửa</a>
            <form asp-action="Delete" asp-route-id="@n.MaNcc" method="post" class="d-inline" data-confirm="Xóa nhà cung cấp @n.Ten?"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>
}
</tbody></table></div></div>
