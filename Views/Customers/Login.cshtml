@{ ViewData["Title"] = "Đăng nhập"; }
<div class="row justify-content-center"><div class="col-md-6 col-lg-4">
    <div class="khung shadow-sm">
        <h1 class="h4 fw-bold text-center mb-1">Đăng nhập</h1>
        <p class="text-center text-muted small mb-3">Dành cho khách hàng, nhân viên và chủ cửa hàng</p>
        @if (ViewBag.LoiDangNhap != null) { <div class="alert alert-danger py-2">@ViewBag.LoiDangNhap</div> }
        <form method="post" asp-action="Login">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="@ViewBag.email" required autofocus /></div>
            <div class="mb-3"><label class="form-label">Mật khẩu</label><input class="form-control" type="password" name="matkhau" required /></div>
            <div class="d-grid"><button class="btn btn-dark">Đăng nhập</button></div>
        </form>
        <div class="mt-3 text-center small">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></div>
    </div>
</div></div>
