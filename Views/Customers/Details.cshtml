@model Mathang
@{
    ViewData["Title"] = Model.Ten;
    var dgs = (List<DanhGia>)ViewBag.DanhGias;
    string ttdg = ViewBag.TrangThaiDanhGia;
    var lienQuan = (List<Mathang>)ViewBag.LienQuan;
    var bts = Model.BienThes.Where(b => b.TrangThai).OrderBy(b => b.KichCo).ThenBy(b => b.MauSac).ToList();
    double tb = dgs.Count > 0 ? dgs.Average(d => d.SoSao) : 0;
    bool giam = Model.GiaGoc > Model.GiaBan;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb small"><li class="breadcrumb-item"><a asp-action="Index">Trang chủ</a></li>
    <li class="breadcrumb-item"><a asp-action="SanPham" asp-route-maDm="@Model.MaDm">@Model.MaDmNavigation?.Ten</a></li><li class="breadcrumb-item active">@Model.Ten</li></ol></nav>
<div class="row g-4">
    <div class="col-md-6">
        <div class="sp-card"><div class="anh"><img src="~/images/@(Model.HinhAnh ?? "")" alt="@Model.Ten" onerror="this.style.visibility='hidden'" /></div></div>
    </div>
    <div class="col-md-6">
        <h1 class="h3 fw-bold">@Model.Ten</h1>
        <div class="sao mb-2">@for (int i = 1; i <= 5; i++) { <i class="bi @(i <= Math.Round(tb) ? "bi-star-fill" : "bi-star")"></i> } <span class="text-muted">@tb.ToString("0.0") (@dgs.Count đánh giá) · Đã bán @(Model.LuotMua ?? 0)</span></div>
        <div class="fs-3 mb-3"><span class="gia">@Model.GiaBan?.ToString("N0")đ</span> @if (giam) { <span class="gia-cu fs-6">@Model.GiaGoc?.ToString("N0")đ</span> }</div>
        <p class="text-muted">@Model.MoTa</p>

        @if (bts.Count == 0 || bts.All(b => b.SoLuongTon == 0))
        {
            <div class="alert alert-secondary">Sản phẩm tạm hết hàng.</div>
        }
        else
        {
            <form asp-action="AddToCart" method="post">
                <div class="mb-2 fw-semibold">Chọn kích cỡ / màu sắc:</div>
                <div class="chon-bien-the mb-2">
                    @foreach (var b in bts)
                    {
                        <input type="radio" name="maBt" id="bt@b.MaBt" value="@b.MaBt" disabled="@(b.SoLuongTon == 0)" required />
                        <label for="bt@b.MaBt" title="@(b.SoLuongTon == 0 ? "Hết hàng" : "Còn " + b.SoLuongTon)">@b.KichCo / @b.MauSac</label>
                    }
                </div>
                <div class="small text-muted mb-3">Tình trạng: @foreach (var b in bts) { <span class="me-2">@b.KichCo/@b.MauSac: @(b.SoLuongTon > 0 ? (b.SoLuongTon <= 5 ? $"còn {b.SoLuongTon}" : "còn hàng") : "hết")</span> }</div>
                <div class="d-flex gap-2 align-items-center">
                    <input type="number" name="soLuong" value="1" min="1" class="form-control" style="width:90px" />
                    <button class="btn btn-dark btn-lg"><i class="bi bi-bag-plus"></i> Thêm vào giỏ</button>
                </div>
            </form>
        }
        <ul class="list-unstyled small text-muted mt-4 mb-0">
            <li><i class="bi bi-check2"></i> Thanh toán khi nhận hàng (COD)</li>
            <li><i class="bi bi-check2"></i> Hủy đơn miễn phí khi đơn còn chờ xác nhận</li>
            <li><i class="bi bi-check2"></i> Đổi size/màu tại cửa hàng khi còn hóa đơn</li>
        </ul>
    </div>
</div>

<hr class="my-5" />
<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h5 fw-bold mb-3">Đánh giá từ khách đã mua (@dgs.Count)</h2>
        @foreach (var d in dgs)
        {
            <div class="border-bottom pb-3 mb-3">
                <div class="d-flex justify-content-between"><b>@d.MaKhNavigation?.Ten</b><small class="text-muted">@d.NgayDanhGia.ToString("dd/MM/yyyy")</small></div>
                <div class="sao">@for (int i = 1; i <= 5; i++) { <i class="bi @(i <= d.SoSao ? "bi-star-fill" : "bi-star")"></i> } <span class="badge bg-light text-success border ms-1">Đã mua hàng</span></div>
                @if (!string.IsNullOrEmpty(d.NhanXet)) { <p class="mb-0 mt-1">@d.NhanXet</p> }
            </div>
        }
        @if (dgs.Count == 0) { <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này.</p> }
    </div>
    <div class="col-lg-5">
        <div class="khung">
            <h3 class="h6 fw-bold">Viết đánh giá</h3>
            @switch (ttdg)
            {
                case "duoc-danh-gia":
                    <form asp-action="DanhGia" method="post">
                        <input type="hidden" name="maMh" value="@Model.MaMh" />
                        <div class="mb-2"><label class="form-label small">Số sao</label>
                            <select name="soSao" class="form-select"><option value="5">★★★★★ Rất hài lòng</option><option value="4">★★★★ Hài lòng</option><option value="3">★★★ Bình thường</option><option value="2">★★ Chưa hài lòng</option><option value="1">★ Tệ</option></select></div>
                        <div class="mb-2"><label class="form-label small">Nhận xét</label><textarea name="nhanXet" rows="3" maxlength="1000" class="form-control" placeholder="Chất liệu, form dáng, size có vừa không..."></textarea></div>
                        <button class="btn btn-dark">Gửi đánh giá</button>
                        <p class="small text-muted mt-2 mb-0">Mỗi sản phẩm đã mua được đánh giá 1 lần. Đánh giá hiển thị sau khi cửa hàng duyệt.</p>
                    </form>
                    break;
                case "da-danh-gia":
                    <p class="mb-0 text-success"><i class="bi bi-check-circle"></i> Bạn đã đánh giá sản phẩm này. Cảm ơn bạn!</p>
                    break;
                case "chua-mua":
                    <p class="mb-0 text-muted">Chỉ khách đã mua và nhận hàng thành công mới được đánh giá sản phẩm này.</p>
                    break;
                default:
                    <p class="mb-0"><a asp-action="Login" asp-route-returnUrl="@Url.Action("Details", new { id = Model.MaMh })">Đăng nhập</a> để đánh giá sản phẩm bạn đã mua.</p>
                    break;
            }
        </div>
    </div>
</div>

@if (lienQuan.Count > 0)
{
    <hr class="my-5" />
    <div class="section-title"><span>Sản phẩm cùng danh mục</span></div>
    <div class="row row-cols-2 row-cols-md-4 g-3">@foreach (var m in lienQuan) { <partial name="_TheSanPham" model="m" /> }</div>
}
