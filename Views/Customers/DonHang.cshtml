@model List<DonHang>
@{ ViewData["Title"] = "Đơn hàng của tôi"; int? tt = ViewBag.TrangThai; }
<h1 class="h4 fw-bold mb-3">Đơn hàng của tôi</h1>
<div class="mb-3">
    <a class="chip @(tt == null ? "active" : "")" asp-action="DonHang">Tất cả</a>
    @foreach (var s in HangSo.TrangThaiDon.TatCa) { <a class="chip @(tt == s ? "active" : "")" asp-action="DonHang" asp-route-trangThai="@s">@HangSo.TrangThaiDon.Ten(s)</a> }
</div>
<div class="khung p-0"><div class="table-responsive"><table class="table align-middle mb-0">
<thead class="table-light"><tr><th>Mã đơn</th><th>Ngày đặt</th><th class="text-end">Số SP</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var d in Model)
{ <tr><td class="fw-semibold">DH@d.MaDh</td><td>@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</td><td class="text-end">@d.CtDonHangs.Sum(c => c.SoLuong)</td><td class="text-end">@d.TongTien.ToString("N0")đ</td>
    <td><span class="badge bg-@HangSo.TrangThaiDon.Mau(d.TrangThai)">@HangSo.TrangThaiDon.Ten(d.TrangThai)</span></td>
    <td><a asp-action="ChiTietDonHang" asp-route-id="@d.MaDh" class="btn btn-sm btn-outline-dark">Chi tiết</a></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có đơn hàng. <a asp-action="SanPham">Mua sắm ngay</a></td></tr> }
</tbody></table></div></div>
