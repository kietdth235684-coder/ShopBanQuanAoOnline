@model List<BienThe>
@{ ViewData["Title"] = "Tồn kho"; int nguong = ViewBag.Nguong; }
<div class="page-title"><h1>Tồn kho theo size / màu</h1>
    <div><a asp-controller="PhieuNhaps" asp-action="Create" class="btn btn-primary">Nhập hàng</a> <a asp-controller="KiemKes" asp-action="Create" class="btn btn-outline-primary">Kiểm kê</a> <a asp-action="NhapXuatTon" class="btn btn-outline-secondary">Nhập – xuất – tồn</a></div></div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-md-4"><label class="form-label">Tên SP / màu / size</label><input name="tukhoa" value="@ViewBag.tukhoa" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">Danh mục</label><select name="maDm" asp-items="ViewBag.DanhMuc" class="form-select"><option value="">Tất cả</option></select></div>
    <div class="col-md-3"><div class="form-check mt-4"><input type="checkbox" name="tonThap" value="true" class="form-check-input" id="tt" checked="@ViewBag.TonThap" /><label class="form-check-label" for="tt">Chỉ hàng tồn thấp (≤ @nguong)</label></div></div>
    <div class="col-md-2 d-grid"><button class="btn btn-secondary">Lọc</button></div>
</form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Size</th><th>Màu</th><th class="text-end">Tồn</th><th>Cảnh báo</th><th></th></tr></thead><tbody>
@foreach (var b in Model)
{
    <tr class="@(b.TrangThai && b.SoLuongTon <= nguong ? "table-warning" : "")">
        <td><a asp-controller="Mathangs" asp-action="Details" asp-route-id="@b.MaMh">@b.MaMhNavigation?.Ten</a> @if (!b.TrangThai || b.MaMhNavigation?.TrangThai == false) { <span class="badge bg-secondary">ngừng bán</span> }</td>
        <td>@b.MaMhNavigation?.MaDmNavigation?.Ten</td><td>@b.KichCo</td><td>@b.MauSac</td><td class="text-end fw-bold">@b.SoLuongTon</td>
        <td>@if (b.SoLuongTon == 0) { <span class="badge bg-danger">Hết hàng</span> } else if (b.SoLuongTon <= nguong) { <span class="badge bg-warning text-dark">Sắp hết</span> }</td>
        <td><a asp-action="TheKho" asp-route-id="@b.MaBt" class="btn btn-sm btn-outline-secondary">Thẻ kho</a></td>
    </tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">Không có dữ liệu.</td></tr> }
</tbody></table></div></div>
