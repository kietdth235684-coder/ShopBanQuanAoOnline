@model Mathang
@{ ViewData["Title"] = "Sửa sản phẩm"; }
<div class="page-title"><h1>Sửa sản phẩm #@Model.MaMh</h1><a asp-action="Details" asp-route-id="@Model.MaMh" class="btn btn-light">← Chi tiết</a></div>
<div class="card"><div class="card-body">
<form asp-action="Edit" enctype="multipart/form-data" method="post">
    <input type="hidden" asp-for="MaMh" />
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary"><i class="bi bi-save"></i> Lưu thay đổi</button>
</form>
</div></div>
