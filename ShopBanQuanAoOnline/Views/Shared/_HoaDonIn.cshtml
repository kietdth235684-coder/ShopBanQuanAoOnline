@* Nội dung hóa đơn bán hàng nội bộ - dùng chung cho trang quản trị và trang khách hàng *@
@model Hoadon
@{ var ch = ViewBag.CuaHang as Cuahang; }
<div class="text-center mb-3">
    <h4 class="mb-0">@(ch?.Ten ?? "Shop quần áo MIKA")</h4>
    <div class="small text-muted">@ch?.DiaChi · ĐT: @ch?.DienThoai</div>
    <h5 class="mt-3 mb-0">HÓA ĐƠN BÁN HÀNG</h5>
    <div class="small">Số: HD@Model.MaHd · Ngày: @Model.Ngay?.ToString("dd/MM/yyyy HH:mm")</div>
    <div class="small text-muted">(Hóa đơn nội bộ – không phải hóa đơn điện tử thuế)</div>
</div>
<div class="row small mb-2">
    <div class="col-6"><b>Khách hàng:</b> @(Model.MaKhNavigation?.Ten ?? "Khách lẻ") @Model.MaKhNavigation?.DienThoai</div>
    <div class="col-6 text-end"><b>Hình thức:</b> @HangSo.LoaiHoaDon.Ten(Model.LoaiHd) @(Model.MaDh.HasValue ? "– Đơn DH" + Model.MaDh : "")</div>
    @if (Model.MaDhNavigation != null) { <div class="col-12"><b>Giao đến:</b> @Model.MaDhNavigation.HoTenNhan – @Model.MaDhNavigation.DiaChiNhan</div> }
    <div class="col-12"><b>Nhân viên:</b> @Model.MaNvNavigation?.Ten</div>
</div>
<table class="table table-sm table-bordered">
    <thead><tr><th>#</th><th>Sản phẩm</th><th>Size / Màu</th><th class="text-end">Đơn giá</th><th class="text-end">SL</th><th class="text-end">Thành tiền</th></tr></thead>
    <tbody>
    @{ int i = 1; }
    @foreach (var c in Model.Cthoadons)
    { <tr><td>@(i++)</td><td>@c.MaMhNavigation?.Ten</td><td>@c.MaBtNavigation?.TenBienThe</td><td class="text-end">@c.DonGia?.ToString("N0")</td><td class="text-end">@c.SoLuong</td><td class="text-end">@c.ThanhTien?.ToString("N0")</td></tr> }
    </tbody>
    <tfoot>
        <tr><th colspan="5" class="text-end">Tổng cộng</th><th class="text-end">@Model.TongTien?.ToString("N0") đ</th></tr>
        @if (Model.TienKhachDua.HasValue && Model.LoaiHd == HangSo.LoaiHoaDon.TaiQuay)
        {
            <tr><td colspan="5" class="text-end">Tiền khách đưa</td><td class="text-end">@Model.TienKhachDua?.ToString("N0") đ</td></tr>
            <tr><td colspan="5" class="text-end">Tiền thối</td><td class="text-end">@((Model.TienKhachDua - Model.TongTien)?.ToString("N0")) đ</td></tr>
        }
    </tfoot>
</table>
@if (!string.IsNullOrEmpty(Model.GhiChu)) { <p class="small"><b>Ghi chú:</b> @Model.GhiChu</p> }
<p class="text-center small text-muted">Cảm ơn quý khách! Hỗ trợ đổi size/màu hoặc trả hàng theo chính sách của cửa hàng khi còn hóa đơn.</p>
