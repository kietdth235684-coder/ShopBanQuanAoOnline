@model IEnumerable<ShopBanQuanAoOnline.Models.Cuahang>

@{
    ViewData["Title"] = "Danh sách";
}

<h1>Thông tin cửa hàng</h1>

<p>
    <a asp-action="Create">Thêm mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ten)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DienThoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiaChi)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Ten)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DienThoai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiaChi)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaCh">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.MaCh">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.MaCh">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
