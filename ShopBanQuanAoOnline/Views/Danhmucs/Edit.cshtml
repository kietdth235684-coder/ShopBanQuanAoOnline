@model Danhmuc
@{ ViewData["Title"] = "Sửa danh mục"; }
<div class="page-title"><h1>Sửa danh mục</h1><a asp-action="Index" class="btn btn-light">← Danh sách</a></div>
<div class="card"><div class="card-body" style="max-width:520px">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaDm" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Ten" class="form-label">Tên danh mục</label><input asp-for="Ten" class="form-control" /><span asp-validation-for="Ten" class="text-danger small"></span></div>
    <button class="btn btn-primary">Lưu</button>
</form>
</div></div>
