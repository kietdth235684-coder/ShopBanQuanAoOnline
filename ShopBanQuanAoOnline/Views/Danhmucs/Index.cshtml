@model IEnumerable<Danhmuc>
@{ ViewData["Title"] = "Danh mục"; bool chu = (bool)(ViewData["LaChuCuaHang"] ?? false); }
<div class="page-title"><h1>Danh mục sản phẩm</h1>@if (chu) { <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm danh mục</a> }</div>
<div class="card"><table class="table table-hover mb-0">
    <thead><tr><th>Mã</th><th>Tên danh mục</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.MaDm</td><td>@item.Ten</td>
            <td class="text-nowrap"><a asp-controller="Mathangs" asp-action="Index" asp-route-maDm="@item.MaDm" class="btn btn-sm btn-outline-primary">Xem sản phẩm</a>
                @if (chu) { <a asp-action="Edit" asp-route-id="@item.MaDm" class="btn btn-sm btn-outline-secondary">Sửa</a> <a asp-action="Delete" asp-route-id="@item.MaDm" class="btn btn-sm btn-outline-danger">Xóa</a> }</td></tr>
    }
    </tbody>
</table></div>
