@model Nhanvien
@{ ViewData["Title"] = "Thêm nhân viên"; }
<div class="page-title"><h1>Thêm nhân viên</h1><a asp-action="Index" class="btn btn-light">← Danh sách</a></div>
<div class="card"><div class="card-body">
<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
    <div class="row"><div class="col-md-6 mb-3"><label class="form-label">Mật khẩu (≥ 6 ký tự)</label><input type="password" name="matKhau" class="form-control" minlength="6" required /></div></div>
    <button class="btn btn-primary">Lưu</button>
</form>
</div></div>
