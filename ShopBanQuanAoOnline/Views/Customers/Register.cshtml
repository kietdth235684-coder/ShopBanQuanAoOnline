@{ ViewData["Title"] = "Đăng ký tài khoản"; }
<div class="row justify-content-center"><div class="col-md-7 col-lg-5">
    <div class="khung shadow-sm">
        <h1 class="h4 fw-bold text-center mb-3">Đăng ký tài khoản</h1>
        <div asp-validation-summary="All" class="text-danger small"></div>
        <form method="post" asp-action="Register">
            <div class="mb-3"><label class="form-label">Họ tên</label><input class="form-control" name="hoten" value="@ViewBag.hoten" maxlength="100" required /></div>
            <div class="mb-3"><label class="form-label">Email (dùng để đăng nhập)</label><input class="form-control" type="email" name="email" value="@ViewBag.email" maxlength="100" required /></div>
            <div class="mb-3"><label class="form-label">Số điện thoại</label><input class="form-control" name="dienthoai" value="@ViewBag.dienthoai" pattern="0[0-9]{9,10}" title="10–11 số, bắt đầu bằng 0" required /></div>
            <div class="row">
                <div class="col-6 mb-3"><label class="form-label">Mật khẩu</label><input class="form-control" type="password" name="matkhau" minlength="6" required /></div>
                <div class="col-6 mb-3"><label class="form-label">Nhập lại</label><input class="form-control" type="password" name="xacnhan" minlength="6" required /></div>
            </div>
            <div class="d-grid"><button class="btn btn-dark">Đăng ký</button></div>
        </form>
        <div class="mt-3 text-center small">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></div>
    </div>
</div></div>
