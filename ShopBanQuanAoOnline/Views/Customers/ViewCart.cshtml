@model List<CartItem>
@{ ViewData["Title"] = "Giỏ hàng"; var canhBao = (List<string>)ViewBag.CanhBao; int tong = Model.Sum(i => i.ThanhTien); }
<h1 class="h4 fw-bold mb-3">Giỏ hàng của bạn</h1>
@foreach (var c in canhBao) { <div class="alert alert-warning py-2">@c</div> }
@if (Model.Count > 0)
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="khung p-0"><div class="table-responsive"><table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Sản phẩm</th><th class="text-end">Đơn giá</th><th style="width:170px">Số lượng</th><th class="text-end">Thành tiền</th><th></th></tr></thead>
                <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td><div class="d-flex align-items-center gap-2">
                            <img src="~/images/@i.HinhAnh" width="56" height="64" class="rounded" style="object-fit:cover" alt="" />
                            <div><a asp-action="Details" asp-route-id="@i.MaMh" class="fw-semibold text-decoration-none">@i.Ten</a><br /><small class="text-muted">Size @i.KichCo · Màu @i.MauSac</small></div></div></td>
                        <td class="text-end">@i.DonGia.ToString("N0")đ</td>
                        <td><form asp-action="UpdateItem" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@i.MaBt" />
                            <input type="number" name="quantity" value="@i.SoLuong" min="0" class="form-control form-control-sm" style="width:70px" />
                            <button class="btn btn-sm btn-outline-dark" title="Cập nhật"><i class="bi bi-arrow-repeat"></i></button></form></td>
                        <td class="text-end fw-semibold">@i.ThanhTien.ToString("N0")đ</td>
                        <td><form asp-action="RemoveItem" method="post"><input type="hidden" name="id" value="@i.MaBt" /><button class="btn btn-sm btn-link text-danger" title="Xóa"><i class="bi bi-trash"></i></button></form></td>
                    </tr>
                }
                </tbody>
            </table></div></div>
            <a class="btn btn-link mt-2" asp-action="SanPham">← Tiếp tục mua sắm</a>
        </div>
        <div class="col-lg-4">
            <div class="khung">
                <div class="d-flex justify-content-between mb-2"><span>Tạm tính (@Model.Sum(i => i.SoLuong) sản phẩm)</span><b>@tong.ToString("N0")đ</b></div>
                <div class="d-flex justify-content-between mb-3 small text-muted"><span>Hình thức thanh toán</span><span>COD – trả khi nhận hàng</span></div>
                <div class="d-grid"><a class="btn btn-dark btn-lg" asp-action="CheckOut">Tiến hành đặt hàng</a></div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5"><i class="bi bi-bag-x fs-1 text-muted"></i><p class="mt-2">Giỏ hàng đang trống.</p><a class="btn btn-dark" asp-action="SanPham">Mua sắm ngay</a></div>
}
