@model List<Mathang>
@{ ViewData["Title"] = "Trang chủ"; var banChay = (List<Mathang>)ViewBag.BanChay; }
@section Banner {
    <section class="hero">
        <div class="container">
            <p class="text-uppercase small mb-2 opacity-75">Bộ sưu tập mới</p>
            <h1>Mặc đẹp mỗi ngày<br />cùng MIKA</h1>
            <p class="lead opacity-75">Áo thun, sơ mi, áo khoác, quần short – đủ size, nhiều màu.</p>
            <a asp-action="SanPham" class="btn btn-light btn-lg mt-2">Mua sắm ngay <i class="bi bi-arrow-right"></i></a>
        </div>
    </section>
}
<div class="row text-center g-3 mb-4 small">
    <div class="col-6 col-md-3"><div class="khung"><i class="bi bi-cash-coin fs-3"></i><div class="fw-semibold">Thanh toán khi nhận hàng</div></div></div>
    <div class="col-6 col-md-3"><div class="khung"><i class="bi bi-arrow-repeat fs-3"></i><div class="fw-semibold">Đổi size tại cửa hàng</div></div></div>
    <div class="col-6 col-md-3"><div class="khung"><i class="bi bi-truck fs-3"></i><div class="fw-semibold">Theo dõi đơn hàng online</div></div></div>
    <div class="col-6 col-md-3"><div class="khung"><i class="bi bi-star fs-3"></i><div class="fw-semibold">Đánh giá từ khách đã mua</div></div></div>
</div>
@if (banChay.Count > 0)
{
    <div class="section-title"><span>Bán chạy</span><a asp-action="SanPham" asp-route-sapXep="ban-chay">Xem tất cả →</a></div>
    <div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
        @foreach (var m in banChay) { <partial name="_TheSanPham" model="m" /> }
    </div>
}
<div class="section-title"><span>Hàng mới về</span><a asp-action="SanPham">Xem tất cả →</a></div>
<div class="row row-cols-2 row-cols-md-4 g-3">
    @foreach (var m in Model) { <partial name="_TheSanPham" model="m" /> }
</div>
@if (Model.Count == 0) { <p class="text-muted">Chưa có sản phẩm.</p> }
