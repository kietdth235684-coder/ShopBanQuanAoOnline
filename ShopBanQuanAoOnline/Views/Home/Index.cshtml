@model DashboardVM
@{ ViewData["Title"] = "Tổng quan"; }
<div class="page-title">
    <h1>Xin chào, @User.Identity?.Name</h1>
    <div class="d-flex gap-2 align-items-center">
        @if (Model.ChamCongHomNay == null)
        {
            <form asp-controller="ChamCongs" asp-action="VaoCa" method="post"><input type="hidden" name="quayVe" value="home" /><button class="btn btn-success"><i class="bi bi-door-open"></i> Chấm công vào ca</button></form>
        }
        else if (Model.ChamCongHomNay.GioRa == null)
        {
            <span class="text-muted small">Vào ca lúc @Model.ChamCongHomNay.GioVao.ToString("HH:mm")</span>
            <form asp-controller="ChamCongs" asp-action="RaCa" method="post"><input type="hidden" name="quayVe" value="home" /><button class="btn btn-outline-danger"><i class="bi bi-door-closed"></i> Kết thúc ca</button></form>
        }
        else
        {
            <span class="badge bg-success">Đã chấm công hôm nay (@Model.ChamCongHomNay.GioVao.ToString("HH:mm") – @Model.ChamCongHomNay.GioRa?.ToString("HH:mm"))</span>
        }
    </div>
</div>

<div class="row">
    @if (Model.LaChuCuaHang)
    {
        <div class="col-6 col-xl-3 mb-3"><div class="card stat-card"><div class="card-body">
            <div class="nhan">Doanh thu hôm nay</div><div class="so text-success">@Model.DoanhThuHomNay.ToString("N0") đ</div>
            <div class="small text-muted">@Model.HoaDonHomNay hóa đơn hoàn tất</div></div></div></div>
        <div class="col-6 col-xl-3 mb-3"><div class="card stat-card"><div class="card-body">
            <div class="nhan">Doanh thu tháng này</div><div class="so text-primary">@Model.DoanhThuThangNay.ToString("N0") đ</div>
            <a class="small" asp-controller="BaoCaos" asp-action="DoanhThu">Xem báo cáo →</a></div></div></div>
    }
    else
    {
        <div class="col-6 col-xl-3 mb-3"><div class="card stat-card"><div class="card-body">
            <div class="nhan">Hóa đơn hoàn tất hôm nay</div><div class="so">@Model.HoaDonHomNay</div></div></div></div>
    }
    <div class="col-6 col-xl-3 mb-3"><div class="card stat-card"><div class="card-body">
        <div class="nhan">Đơn COD chờ xác nhận</div><div class="so text-warning">@Model.DonChoXacNhan</div>
        <a class="small" asp-controller="DonHangs" asp-action="Index" asp-route-trangThai="0">Xử lý ngay →</a></div></div></div>
    <div class="col-6 col-xl-3 mb-3"><div class="card stat-card"><div class="card-body">
        <div class="nhan">Đơn đang xác nhận/giao</div><div class="so text-info">@Model.DonDangXuLy</div>
        <div class="small text-muted">@Model.DanhGiaChoDuyet đánh giá chờ duyệt</div></div></div></div>
</div>

<div class="row">
    <div class="col-lg-7 mb-3">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <h5 class="card-title mb-0"><i class="bi bi-exclamation-triangle text-danger"></i> Cảnh báo tồn kho thấp (≤ @Model.NguongTonThap)</h5>
                <a asp-controller="Khos" asp-action="Index" asp-route-tonThap="true">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                @if (Model.TonThap.Count == 0)
                {
                    <p class="p-3 mb-0 text-muted">Không có sản phẩm nào sắp hết hàng.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Sản phẩm</th><th>Size / Màu</th><th class="text-end">Tồn</th></tr></thead>
                        <tbody>
                            @foreach (var b in Model.TonThap)
                            {
                                <tr><td>@b.MaMhNavigation?.Ten</td><td>@b.TenBienThe</td>
                                    <td class="text-end"><span class="badge bg-@(b.SoLuongTon == 0 ? "danger" : "warning")">@b.SoLuongTon</span></td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5 mb-3">
        <div class="card h-100"><div class="card-header"><h5 class="card-title mb-0">Thao tác nhanh</h5></div>
            <div class="card-body d-grid gap-2">
                <a class="btn btn-primary" asp-controller="BanHang" asp-action="Index"><i class="bi bi-cash-coin"></i> Bán hàng tại quầy</a>
                <a class="btn btn-outline-primary" asp-controller="DonHangs" asp-action="Index"><i class="bi bi-truck"></i> Xử lý đơn COD</a>
                <a class="btn btn-outline-secondary" asp-controller="PhieuNhaps" asp-action="Create"><i class="bi bi-box-arrow-in-down"></i> Lập phiếu nhập</a>
                <a class="btn btn-outline-secondary" asp-controller="DanhGias" asp-action="Index"><i class="bi bi-star-half"></i> Duyệt đánh giá</a>
            </div>
        </div>
    </div>
</div>
