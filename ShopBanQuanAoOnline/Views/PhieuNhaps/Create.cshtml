@{ ViewData["Title"] = "Lập phiếu nhập"; ViewData["CoDonGia"] = true; }
<div class="page-title"><h1>Lập phiếu nhập hàng</h1><a asp-action="Index" class="btn btn-light">← Danh sách</a></div>
<div class="card"><div class="card-body">
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-md-5 mb-3"><label class="form-label">Nhà cung cấp</label>
            <select name="maNcc" asp-items="ViewBag.NCC" class="form-select" required><option value="">-- Chọn --</option></select>
            <div class="form-text"><a asp-controller="NhaCungCaps" asp-action="Create">+ Thêm nhà cung cấp mới</a></div></div>
        <div class="col-md-7 mb-3"><label class="form-label">Ghi chú</label><input name="ghiChu" maxlength="255" class="form-control" /></div>
    </div>
    <partial name="_DongPhieuKho" />
    <div class="alert alert-info small">Lưu phiếu sẽ cộng tồn kho, ghi thẻ kho và cập nhật giá nhập tham khảo (bình quân). Phiếu đã lưu không sửa/xóa.</div>
    <button class="btn btn-primary"><i class="bi bi-save"></i> Lưu phiếu nhập</button>
</form>
</div></div>
