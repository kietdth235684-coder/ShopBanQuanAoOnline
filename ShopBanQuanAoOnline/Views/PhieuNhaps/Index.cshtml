@model List<PhieuNhap>
@{ ViewData["Title"] = "Phiếu nhập"; }
<div class="page-title"><h1>Phiếu nhập – lịch sử nhập hàng</h1><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Lập phiếu nhập</a></div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label">Từ ngày</label><input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" /></div>
    <div class="col-auto"><label class="form-label">Đến ngày</label><input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control" /></div>
    <div class="col-auto"><label class="form-label">Nhà cung cấp</label><select name="maNcc" asp-items="ViewBag.NCC" class="form-select"><option value="">Tất cả</option></select></div>
    <div class="col-auto"><button class="btn btn-secondary">Lọc</button></div>
</form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Số phiếu</th><th>Ngày nhập</th><th>Nhà cung cấp</th><th>Người lập</th><th class="text-end">Số lượng</th><th class="text-end">Tổng tiền</th><th></th></tr></thead><tbody>
@foreach (var p in Model)
{
    <tr><td>PN@p.MaPn</td><td>@p.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td><td>@p.MaNccNavigation?.Ten</td><td>@p.MaNvNavigation?.Ten</td>
        <td class="text-end">@p.CtPhieuNhaps.Sum(c => c.SoLuong)</td><td class="text-end">@p.TongTien.ToString("N0") đ</td>
        <td><a asp-action="Details" asp-route-id="@p.MaPn" class="btn btn-sm btn-outline-primary">Xem</a></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">Chưa có phiếu nhập.</td></tr> }
</tbody></table></div></div>
