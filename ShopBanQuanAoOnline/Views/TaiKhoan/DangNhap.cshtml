@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập quản trị - MIKA</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="~/css/app.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex align-items-center" style="min-height:100vh;background:linear-gradient(135deg,#1f2a3d,#3b4b66);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-9 col-md-6 col-lg-4">
                <div class="text-center text-white mb-4">
                    <h1 class="h3 text-white"><i class="bi bi-bag-heart-fill"></i> MIKA ADMIN</h1>
                    <p class="mb-0 opacity-75">Đăng nhập dành cho chủ cửa hàng và nhân viên</p>
                </div>
                <div class="card">
                    <div class="card-body p-4">
                        @if (ViewData["Loi"] != null)
                        {
                            <div class="alert alert-danger py-2">@ViewData["Loi"]</div>
                        }
                        <form method="post" asp-action="DangNhap">
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input class="form-control form-control-lg" type="email" name="email" value="@ViewData["Email"]" required autofocus />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Mật khẩu</label>
                                <input class="form-control form-control-lg" type="password" name="matKhau" required />
                            </div>
                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-lg btn-primary"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="text-center mt-3"><a class="text-white-50" asp-controller="Customers" asp-action="Index">← Về website cửa hàng</a></div>
            </div>
        </div>
    </div>
</body>
</html>
