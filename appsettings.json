{
  // =====================================================================
  // CHỈ CẦN SỬA "Server=..." CHO ĐÚNG TÊN SQL SERVER TRÊN MÁY CỦA BẠN
  //   - Xem tên ở ô "Server name" khi đăng nhập SQL Server Management Studio (SSMS).
  //   - Ví dụ: .\\SQLEXPRESS   |   localhost   |   LAPTOP-ABC123\\SQLEXPRESS
  //   - Trong file này dấu \ phải viết thành \\
  //   - Dùng tài khoản SQL: thay Trusted_Connection=True bằng User Id=sa;Password=...
  // Giữ nguyên Database=ShopBanQuanAoOnline (trùng tên trong script SQL).
  // =====================================================================
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=ShopBanQuanAoOnline;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  // Ngưỡng cảnh báo tồn kho thấp (số lượng tồn của 1 size/màu <= giá trị này sẽ được cảnh báo)
  "Kho": {
    "NguongTonThap": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
